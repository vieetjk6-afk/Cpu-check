<Application x:Class="PcCheck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:PcCheck.App.Infrastructure"
             xmlns:vm="clr-namespace:PcCheck.App.ViewModels"
             xmlns:views="clr-namespace:PcCheck.App.Views"
             xmlns:c="clr-namespace:PcCheck.App.Controls"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Vị trí 0 là bảng màu, ThemeManager sẽ thay khi đổi giao diện sáng/tối -->
                <ResourceDictionary Source="Themes/Colors.Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
            <infra:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
            <infra:SeverityBrushConverter x:Key="SeverityBrush" />
            <infra:SeverityGlyphConverter x:Key="SeverityGlyph" />
            <infra:EqualsConverter x:Key="Equals" />
            <infra:PercentToWidthConverter x:Key="PercentToWidth" />


            <!-- ===== Mẫu dùng chung ===== -->
            <ItemsPanelTemplate x:Key="WrapPanelTemplate">
                <WrapPanel />
            </ItemsPanelTemplate>

            <DataTemplate x:Key="FixButtonTemplate">
                <Button Style="{StaticResource LinkButton}" Margin="0,0,8,6" Content="{Binding Label}"
                        Command="{Binding DataContext.ExecuteFixCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
            </DataTemplate>

            <DataTemplate x:Key="IssueCardTemplate">
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="10" VerticalAlignment="Top"
                                Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                            <TextBlock Style="{StaticResource Icon}" FontSize="17"
                                       Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}"
                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Badge}" Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                                    <TextBlock Text="{Binding SeverityText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                </Border>
                                <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" TextWrapping="Wrap" TextTrimming="None" Margin="0,7,0,0" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource CardAltBrush}"
                                    Visibility="{Binding Recommendation, Converter={StaticResource EmptyToCollapsed}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE82F;" FontSize="14" VerticalAlignment="Top" Margin="0,1,0,0"
                                               Foreground="{StaticResource WarningBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Recommendation}" Style="{StaticResource Body}" Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextBrush}" />
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Fixes}" Margin="0,12,0,-6" Focusable="False"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}"
                                          ItemTemplate="{StaticResource FixButtonTemplate}"
                                          Visibility="{Binding Fixes, Converter={StaticResource EmptyToCollapsed}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Ô số liệu (StatTile) -->
            <DataTemplate x:Key="StatTileTemplate">
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Caption}" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Value}" Style="{StaticResource BigNumber}" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="2" Text="{Binding Caption}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <Grid Grid.Row="3" Height="34" Margin="0,10,0,0">
                            <c:Sparkline Values="{Binding History}" Stroke="{DynamicResource AccentBrush}" />
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Thẻ nhóm thông tin (InfoGroup) -->
            <DataTemplate x:Key="InfoGroupTemplate">
                <Border Style="{StaticResource SubCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Top"
                                    Visibility="{Binding StatusText, Converter={StaticResource EmptyToCollapsed}}"
                                    Background="{Binding Status, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{Binding Status, Converter={StaticResource SeverityBrush}}" />
                            </Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,10,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,14,6">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource Value}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Mỗi ViewModel trang được hiển thị bằng View tương ứng -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:HardwareViewModel}"><views:HardwareView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:HealthViewModel}"><views:HealthView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CompatibilityViewModel}"><views:CompatibilityView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DriversViewModel}"><views:DriversView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CleanupViewModel}"><views:CleanupView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:IssuesViewModel}"><views:IssuesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
