<UserControl x:Class="PcCheck.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcCheck.App.Infrastructure"
             xmlns:views="clr-namespace:PcCheck.App.Views">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{l:T page.drivers.title}" Style="{StaticResource H1}" />
                <TextBlock Text="{l:T page.drivers.subtitle}" Style="{StaticResource Body}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ScanHardwareCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE772;" FontSize="14" />
                        <TextBlock Text="{l:T tool.scan-devices.name}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RescanCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" />
                        <TextBlock Text="{l:T common.rescan}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <views:EmptyState Grid.Row="1" Visibility="{Binding NoResult, Converter={StaticResource BoolToVis}}" />

        <!-- Tóm tắt + nguồn driver chính hãng -->
        <Grid Grid.Row="1" Margin="0,0,0,14" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.6*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="{l:T drivers.missing}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding MissingCount}" Style="{StaticResource BigNumber}" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="{l:T drivers.errors}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding ErrorCount}" Style="{StaticResource BigNumber}" Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="{l:T drivers.outdated}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding OutdatedCount}" Style="{StaticResource BigNumber}" Foreground="{StaticResource InfoBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="{l:T drivers.sources}" Style="{StaticResource Caption}" />
                    <WrapPanel Margin="0,8,0,-6">
                        <Button Style="{StaticResource LinkButton}" Margin="0,0,8,6" Content="{l:T fix.optional_updates}"
                                Command="{Binding Main.ExecuteFixCommand}" CommandParameter="{Binding OptionalUpdatesFix}" />
                        <Button Style="{StaticResource LinkButton}" Margin="0,0,8,6" Content="{Binding GpuVendorName}"
                                Command="{Binding Main.ExecuteFixCommand}" CommandParameter="{Binding GpuDriverFix}"
                                Visibility="{Binding GpuDriverFix, Converter={StaticResource EmptyToCollapsed}}" />
                        <Button Style="{StaticResource LinkButton}" Margin="0,0,8,6" Content="{Binding OemName}"
                                Command="{Binding Main.ExecuteFixCommand}" CommandParameter="{Binding OemDriverFix}"
                                Visibility="{Binding OemDriverFix, Converter={StaticResource EmptyToCollapsed}}" />
                        <Button Style="{StaticResource LinkButton}" Margin="0,0,8,6" Content="{l:T tool.devmgmt.name}"
                                Command="{Binding Main.ExecuteFixCommand}" CommandParameter="{Binding DeviceManagerFix}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Chọn tab -->
        <Border Grid.Row="2" Style="{StaticResource SegmentHost}" Margin="0,0,0,14"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="DriverTabs"
                             IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=problems}">
                    <TextBlock>
                        <Run Text="{l:T drivers.tab_problems}" /> (<Run Text="{Binding Problems.Count, Mode=OneWay}" />)
                    </TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="DriverTabs"
                             IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=all}">
                    <TextBlock>
                        <Run Text="{l:T drivers.tab_all}" /> (<Run Text="{Binding TotalCount, Mode=OneWay}" />)
                    </TextBlock>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Tab: cần xử lý -->
        <Grid Grid.Row="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tab}" Value="problems" />
                                <Condition Binding="{Binding HasResult}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding AllGood, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource SuccessBrush}" FontSize="18" />
                            <TextBlock Text="{l:T drivers.all_ok}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Problems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" VerticalAlignment="Top"
                                                Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE772;"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,14,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" Margin="0,3,0,0" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                                                <Run Text="{Binding Meta, Mode=OneWay}" /> · <Run Text="{Binding HardwareId, Mode=OneWay}" />
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Fixes}" Margin="0,10,0,-6" Focusable="False"
                                                          ItemsPanel="{StaticResource WrapPanelTemplate}"
                                                          ItemTemplate="{StaticResource FixButtonTemplate}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Top"
                                                Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                                            <TextBlock Text="{Binding KindText}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Tab: tất cả driver (danh sách ảo hóa) -->
        <Border Grid.Row="3" Padding="0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tab}" Value="all" />
                                <Condition Binding="{Binding HasResult}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox Margin="16,16,16,10" Tag="{l:T drivers.search}" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                <Grid Grid.Row="1" Margin="20,0,24,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.4*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:T driver.device}" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="1" Text="{l:T driver.class}" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="2" Text="{l:T driver.provider}" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="3" Text="{l:T driver.version}" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="4" Text="{l:T driver.date}" Style="{StaticResource Caption}" />
                </Grid>
                <ListBox Grid.Row="2" Style="{StaticResource PlainList}" ItemsSource="{Binding Devices}" Margin="4,0,4,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.4*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,10,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding ClassName}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Provider}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding Version}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding Date}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
