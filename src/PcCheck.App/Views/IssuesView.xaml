<UserControl x:Class="PcCheck.App.Views.IssuesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcCheck.App.Infrastructure"
             xmlns:views="clr-namespace:PcCheck.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,36">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:T page.issues.title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{l:T page.issues.subtitle}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding Main.ExportReportCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="14" />
                        <TextBlock Text="{l:T report.export}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <views:EmptyState Visibility="{Binding NoResult, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16" />

            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <!-- Bộ lọc -->
                <Border Style="{StaticResource SegmentHost}" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="IssueFilter"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=all}">
                            <TextBlock><Run Text="{l:T issues.filter_all}" /> (<Run Text="{Binding AllCount, Mode=OneWay}" />)</TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="IssueFilter"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=critical}">
                            <TextBlock><Run Text="{l:T severity.critical}" /> (<Run Text="{Binding CriticalCount, Mode=OneWay}" />)</TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="IssueFilter"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=warning}">
                            <TextBlock><Run Text="{l:T severity.warning}" /> (<Run Text="{Binding WarningCount, Mode=OneWay}" />)</TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="IssueFilter"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=info}">
                            <TextBlock><Run Text="{l:T severity.info}" /> (<Run Text="{Binding InfoCount, Mode=OneWay}" />)</TextBlock>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding NoIssues, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource SuccessBrush}" FontSize="18" />
                        <TextBlock Text="{l:T issues.none}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Issues}" ItemTemplate="{StaticResource IssueCardTemplate}" Focusable="False" />

                <!-- Thống kê lỗi hệ thống -->
                <TextBlock Text="{Binding EventsTitle}" Style="{StaticResource H2}" Margin="0,18,0,4" />
                <TextBlock Text="{l:T issues.events_desc}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding Events}" Margin="0,0,-12,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="10" VerticalAlignment="Top"
                                            Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource BigNumber}" FontSize="24"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Công cụ sửa lỗi nhanh -->
            <TextBlock Text="{l:T issues.tools}" Style="{StaticResource H2}" Margin="0,18,0,4" />
            <TextBlock Text="{l:T issues.tools_desc}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding Tools}" Margin="0,0,-12,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,12,12" Padding="16,14" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                Style="{StaticResource TileButton}" Command="{Binding Command}" ToolTip="{Binding Description}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                                               MaxHeight="34" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
