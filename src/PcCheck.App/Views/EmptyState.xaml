<UserControl x:Class="PcCheck.App.Views.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcCheck.App.Infrastructure">
    <!-- Hiển thị khi chưa có kết quả quét. DataContext = ViewModel trang (có thuộc tính Main). -->
    <Border Style="{StaticResource Card}" Padding="32" Margin="0,8,0,0">
        <StackPanel HorizontalAlignment="Center" MaxWidth="460">
            <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="28" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock Text="{l:T empty.title}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock Text="{l:T empty.desc}" Style="{StaticResource Body}" TextAlignment="Center" Margin="0,8,0,0" />
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding Main.ScanCommand}" HorizontalAlignment="Center" Margin="0,18,0,0"
                    Content="{l:T scan.button}" />
            <ProgressBar Margin="0,16,0,0" Width="280" Maximum="100" Value="{Binding Main.ScanPercent, Mode=OneWay}"
                         Visibility="{Binding Main.IsScanning, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Main.ScanStep}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0"
                       Visibility="{Binding Main.IsScanning, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Border>
</UserControl>
