<UserControl x:Class="PcCheck.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcCheck.App.Infrastructure">
    <UserControl.Resources>
        <Style x:Key="TabPanel" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="{l:T page.performance.title}" Style="{StaticResource H1}" />
            <TextBlock Text="{l:T page.performance.subtitle}" Style="{StaticResource Body}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SegmentHost}" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="PerfTabs" Content="{l:T perf.tab_live}"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=0}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="PerfTabs" Content="{l:T perf.tab_bench}"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=1}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="PerfTabs" Content="{l:T perf.tab_optimize}"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=2}" />
            </StackPanel>
        </Border>

        <!-- ================= Tab 1: Trực tiếp ================= -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>
                <Border Style="{StaticResource SubCard}" Margin="0,0,0,12">
                    <TextBlock Text="{Binding SystemSummary}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                </Border>
                <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource StatTileTemplate}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="{l:T perf.live_hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- ================= Tab 2: Đo tốc độ ================= -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>
                <!-- Tùy chọn -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{l:T bench.title}" Style="{StaticResource H2}" />
                        <TextBlock Text="{l:T bench.intro}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,4,0,12" />

                        <CheckBox IsChecked="{Binding IncludeDisk}" IsEnabled="{Binding IsBenchmarking, Converter={StaticResource Equals}, ConverterParameter=False}">
                            <TextBlock Text="{l:T bench.include_disk}" />
                        </CheckBox>
                        <ItemsControl ItemsSource="{Binding Drives}" Focusable="False" Margin="26,8,0,0"
                                      Visibility="{Binding IncludeDisk, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SegmentHost}" Margin="0,0,6,6" Padding="1">
                                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="BenchDrive" Content="{Binding Text}" IsChecked="{Binding IsSelected}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox IsChecked="{Binding IncludeInternet}" Margin="0,8,0,0">
                            <TextBlock Text="{l:T bench.include_internet}" TextWrapping="Wrap" />
                        </CheckBox>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding RunBenchmarkCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEC4A;" FontSize="13" Foreground="White" />
                                    <TextBlock Text="{l:T bench.run}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Content="{l:T bench.cancel}" Command="{Binding CancelBenchmarkCommand}" Margin="8,0,0,0"
                                    Visibility="{Binding IsBenchmarking, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0" Visibility="{Binding IsBenchmarking, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding BenchStage}" Style="{StaticResource Body}" />
                            <ProgressBar Margin="0,8,0,0" Height="5" Maximum="100" Value="{Binding BenchPercent, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Kết quả -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{l:T bench.results}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding LastRunText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Nhận xét -->
                        <ItemsControl ItemsSource="{Binding Notes}" Focusable="False" Margin="0,12,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="12,9" Margin="0,0,0,6"
                                            Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}" FontSize="14"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" VerticalAlignment="Top" Margin="0,1,10,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Body}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Results}" Focusable="False" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                 Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                        <StackPanel Grid.Column="1" Margin="0,6">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Group}" Style="{StaticResource Caption}" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap"
                                                       Visibility="{Binding Hint, Converter={StaticResource EmptyToCollapsed}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Change}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   ToolTip="{l:T bench.change_tip}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFaster}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Grid.Row="1" Grid.ColumnSpan="4" Height="1" Background="{DynamicResource LineBrush}" Margin="0,2,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{l:T bench.footnote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SubCard}" Visibility="{Binding NoResults, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{l:T bench.no_results}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= Tab 3: Tối ưu ================= -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTab}" Value="2">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="78" Height="78" CornerRadius="39" BorderThickness="5"
                                BorderBrush="{Binding ScoreSeverity, Converter={StaticResource SeverityBrush}}"
                                Visibility="{Binding HasChecked, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Score}" Style="{StaticResource BigNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{l:T opt.title}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding ScoreText}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{l:T opt.checking}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{l:T opt.scan_hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding NoResult, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding CheckCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                                <TextBlock Text="{l:T opt.recheck}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12"
                             Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{Binding OptItems}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="8" VerticalAlignment="Top"
                                                Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}" FontSize="14"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" />
                                                <Border Style="{StaticResource Badge}" Background="{DynamicResource CardAltBrush}" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding GroupText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Margin="6,0,0,0"
                                                        Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                                                    <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="{Binding IsGood, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                <Run Text="{l:T opt.impact_label}" />
                                                <Run Text="{Binding ImpactText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{StaticResource GhostButton}" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Content="{l:T opt.guide}" Margin="0,0,6,0"
                                                    Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource PrimaryButton}" Padding="12,7" Command="{Binding FixCommand}" Content="{Binding FixLabel}"
                                                    Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource SubCard}" Margin="42,10,0,0"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{l:T opt.steps_title}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource TextBrush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
