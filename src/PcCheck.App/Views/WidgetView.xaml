<UserControl x:Class="PcCheck.App.Views.WidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcCheck.App.Infrastructure"
             xmlns:views="clr-namespace:PcCheck.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,28,32,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Tiêu đề -->
            <Grid Grid.ColumnSpan="2" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:T page.widget.title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{l:T page.widget.subtitle}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding ToggleCommand}" VerticalAlignment="Center" MinWidth="150">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="{l:T widget.show}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                    <Setter Property="Content" Value="{l:T widget.hide}" />
                                    <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Cột trái: cài đặt -->
            <StackPanel Grid.Row="1" Margin="0,0,16,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{l:T widget.behavior}" Style="{StaticResource H2}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,14">
                            <StackPanel Margin="0,0,70,0">
                                <TextBlock Text="{l:T widget.visible}" Style="{StaticResource H3}" />
                                <TextBlock Text="{l:T widget.visible_desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsVisible}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Margin="0,0,70,0">
                                <TextBlock Text="{l:T widget.topmost}" Style="{StaticResource H3}" />
                                <TextBlock Text="{l:T widget.topmost_desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AlwaysOnTop}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Margin="0,0,70,0">
                                <TextBlock Text="{l:T widget.locked}" Style="{StaticResource H3}" />
                                <TextBlock Text="{l:T widget.locked_desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Locked}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Margin="0,0,70,0">
                                <TextBlock Text="{l:T widget.graphs}" Style="{StaticResource H3}" />
                                <TextBlock Text="{l:T widget.graphs_desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowGraphs}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid>
                            <StackPanel Margin="0,0,70,0">
                                <TextBlock Text="{l:T widget.autostart}" Style="{StaticResource H3}" />
                                <TextBlock Text="{l:T widget.autostart_desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoStart}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsEnabled="{Binding AutoStartBusy, Converter={StaticResource Equals}, ConverterParameter=False}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{l:T widget.appearance}" Style="{StaticResource H2}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="{l:T widget.opacity}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="WOpacity" Content="100%"
                                                 IsChecked="{Binding OpacityPercent, Converter={StaticResource Equals}, ConverterParameter=100}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="WOpacity" Content="90%"
                                                 IsChecked="{Binding OpacityPercent, Converter={StaticResource Equals}, ConverterParameter=90}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="WOpacity" Content="75%"
                                                 IsChecked="{Binding OpacityPercent, Converter={StaticResource Equals}, ConverterParameter=75}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="WOpacity" Content="60%"
                                                 IsChecked="{Binding OpacityPercent, Converter={StaticResource Equals}, ConverterParameter=60}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="{l:T widget.size}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="WSize" Content="{l:T widget.size_small}"
                                                 IsChecked="{Binding Size, Converter={StaticResource Equals}, ConverterParameter=small}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="WSize" Content="{l:T widget.size_medium}"
                                                 IsChecked="{Binding Size, Converter={StaticResource Equals}, ConverterParameter=medium}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="WSize" Content="{l:T widget.size_large}"
                                                 IsChecked="{Binding Size, Converter={StaticResource Equals}, ConverterParameter=large}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="{l:T widget.layout}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="WLayout" Content="{l:T widget.layout_vertical}"
                                                 IsChecked="{Binding Layout, Converter={StaticResource Equals}, ConverterParameter=vertical}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="WLayout" Content="{l:T widget.layout_horizontal}"
                                                 IsChecked="{Binding Layout, Converter={StaticResource Equals}, ConverterParameter=horizontal}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="{l:T widget.interval}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="WInterval" Content="{l:T widget.interval_1}"
                                                 IsChecked="{Binding Interval, Converter={StaticResource Equals}, ConverterParameter=1}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="WInterval" Content="{l:T widget.interval_2}"
                                                 IsChecked="{Binding Interval, Converter={StaticResource Equals}, ConverterParameter=2}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="WInterval" Content="{l:T widget.interval_5}"
                                                 IsChecked="{Binding Interval, Converter={StaticResource Equals}, ConverterParameter=5}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Button HorizontalAlignment="Left" Command="{Binding ResetPositionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7AD;" FontSize="13" />
                                <TextBlock Text="{l:T widget.reset_position}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{l:T widget.metrics}" Style="{StaticResource H2}" />
                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Command="{Binding ResetMetricsCommand}"
                                    Content="{l:T widget.reset_metrics}" />
                        </Grid>
                        <TextBlock Text="{l:T widget.metrics_desc}" Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap" TextTrimming="None" />
                        <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SubCard}" Margin="0,0,10,10" Padding="12,10">
                                        <CheckBox IsChecked="{Binding IsChecked}" VerticalContentAlignment="Top">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                                           TextWrapping="Wrap" TextTrimming="None" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Cột phải: xem trước trực tiếp -->
            <StackPanel Grid.Row="1" Grid.Column="1" Width="290">
                <TextBlock Text="{l:T widget.preview}" Style="{StaticResource H3}" Margin="2,0,0,10" />
                <Border CornerRadius="16" BorderThickness="1" Padding="14,10,14,12" HorizontalAlignment="Left"
                        Background="{DynamicResource WidgetBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" Color="Black" />
                    </Border.Effect>
                    <views:WidgetPanel />
                </Border>
                <Border Style="{StaticResource SubCard}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE82F;" FontSize="14" VerticalAlignment="Top" Margin="0,1,0,0"
                                   Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Grid.Column="1" Text="{l:T widget.tip}" Style="{StaticResource Body}" Margin="8,0,0,0" FontSize="12.5" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
