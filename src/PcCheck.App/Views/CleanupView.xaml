<UserControl x:Class="PcCheck.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcCheck.App.Infrastructure"
             xmlns:views="clr-namespace:PcCheck.App.Views">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{l:T page.cleanup.title}" Style="{StaticResource H1}" />
            <TextBlock Text="{l:T page.cleanup.subtitle}" Style="{StaticResource Body}" Margin="0,4,0,0" />
        </StackPanel>

        <views:EmptyState Grid.Row="1" Visibility="{Binding NoResult, Converter={StaticResource BoolToVis}}" />

        <Grid Grid.Row="2" Margin="0,0,0,14" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource SegmentHost}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="CleanupTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=0}">
                        <TextBlock>
                            <Run Text="{l:T cleanup.tab_junk}" /> (<Run Text="{Binding TotalSize, Mode=OneWay}" />)
                        </TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="CleanupTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=1}">
                        <TextBlock>
                            <Run Text="{l:T cleanup.tab_software}" /> (<Run Text="{Binding SuggestedCount, Mode=OneWay}" />)
                        </TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="CleanupTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=2}">
                        <TextBlock>
                            <Run Text="{l:T cleanup.tab_startup}" /> (<Run Text="{Binding StartupEnabledCount, Mode=OneWay}" />)
                        </TextBlock>
                    </RadioButton>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding BusyText}" Style="{StaticResource Caption}" MaxWidth="320" />
            </StackPanel>
        </Grid>

        <!-- ===== Tab 1: Tệp rác ===== -->
        <Grid Grid.Row="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SelectedTab}" Value="0" />
                                <Condition Binding="{Binding HasResult}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="19" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T junk.selected}" />
                        <TextBlock Style="{StaticResource H2}" Text="{Binding SelectedSize}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding SelectAllCommand}" Content="{l:T common.select_all}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding SelectNoneCommand}" Content="{l:T common.select_none}" Margin="4,0,12,0" />
                        <Button Command="{Binding ScanJunkCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" />
                                <TextBlock Text="{l:T common.rescan}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding CleanCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Foreground="White" />
                                <TextBlock Text="{l:T junk.clean}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding JunkItems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                                  IsEnabled="{Binding IsEmpty, Converter={StaticResource Equals}, ConverterParameter=False}" />
                                        <StackPanel Grid.Column="1" Margin="4,0,16,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Margin="0,2,0,0" FontSize="12.5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="90">
                                            <TextBlock Text="{Binding Size}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding Files}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource SubCard}" Margin="0,6,0,0">
                        <Grid>
                            <TextBlock Text="{l:T junk.disk_cleanup_hint}" Style="{StaticResource Body}" Margin="0,0,180,0" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Command="{Binding DiskCleanupCommand}" Content="{l:T tool.cleanmgr.name}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Tab 2: Phần mềm ===== -->
        <Border Grid.Row="3" Padding="0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SelectedTab}" Value="1" />
                                <Condition Binding="{Binding HasResult}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="16,16,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SegmentHost}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="SoftwareFilter" Content="{l:T software.filter_suggested}"
                                         IsChecked="{Binding SoftwareFilter, Converter={StaticResource Equals}, ConverterParameter=suggested}" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="SoftwareFilter" Content="{l:T software.filter_unused}"
                                         IsChecked="{Binding SoftwareFilter, Converter={StaticResource Equals}, ConverterParameter=unused}" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="SoftwareFilter" Content="{l:T software.filter_bloat}"
                                         IsChecked="{Binding SoftwareFilter, Converter={StaticResource Equals}, ConverterParameter=bloat}" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="SoftwareFilter" Content="{l:T software.filter_all}"
                                         IsChecked="{Binding SoftwareFilter, Converter={StaticResource Equals}, ConverterParameter=all}" />
                        </StackPanel>
                    </Border>
                    <TextBox Grid.Column="1" Margin="12,0,12,0" Tag="{l:T software.search}"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                    <Button Grid.Column="2" Command="{Binding RefreshSoftwareCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" />
                            <TextBlock Text="{l:T common.refresh}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding ProgramsSummary}" Style="{StaticResource Caption}" Margin="20,0,20,8" />
                <ListBox Grid.Row="2" Style="{StaticResource PlainList}" ItemsSource="{Binding Programs}" Margin="4,0,4,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" FontWeight="Normal" MaxWidth="420" />
                                            <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Padding="8,1"
                                                    Visibility="{Binding TagText, Converter={StaticResource EmptyToCollapsed}}"
                                                    Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                                                <TextBlock Text="{Binding TagText}" FontSize="11"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                            <Run Text="{Binding Publisher, Mode=OneWay}" /> · <Run Text="{Binding Version, Mode=OneWay}" /> · <Run Text="{l:T software.installed}" /> <Run Text="{Binding Installed, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Size}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding LastUsed}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                            Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <TextBlock Text="{l:T software.uninstall}" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ===== Tab 3: Khởi động cùng Windows ===== -->
        <Grid Grid.Row="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SelectedTab}" Value="2" />
                                <Condition Binding="{Binding HasResult}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource SubCard}" Margin="0,0,0,12">
                <Grid>
                    <TextBlock Text="{l:T startup.hint}" Style="{StaticResource Body}" Margin="0,0,200,0" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Command="{Binding OpenTaskManagerCommand}" Content="{l:T startup.open_settings}" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding StartupItems}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                            <Run Text="{Binding Publisher, Mode=OneWay}" /> · <Run Text="{Binding Location, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Command}" Style="{StaticResource Caption}" Margin="0,2,0,0" ToolTip="{Binding Command}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
