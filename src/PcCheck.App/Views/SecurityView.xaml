<UserControl x:Class="PcCheck.App.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcCheck.App.Infrastructure"
             xmlns:views="clr-namespace:PcCheck.App.Views">
    <UserControl.Resources>
        <!-- Một phát hiện: tiêu đề + mô tả + bằng chứng + nhãn + nút; bấm để xem cách xử lý -->
        <DataTemplate x:Key="SecurityItemTemplate">
            <Border Style="{StaticResource SubCard}" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" VerticalAlignment="Top"
                            Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}"
                                   Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <ToggleButton Style="{StaticResource ExpandHeader}" IsChecked="{Binding IsExpanded}" IsHitTestVisible="{Binding HasGuide}"
                                      Focusable="{Binding HasGuide}" AutomationProperties.Name="{Binding Title}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" FontSize="13.5" TextWrapping="Wrap" TextTrimming="None" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" Margin="0,3,0,0"
                                               Visibility="{Binding Detail, Converter={StaticResource EmptyToCollapsed}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Style="{StaticResource Chevron}" Tag="{Binding IsExpanded}" Margin="10,2,0,0" VerticalAlignment="Top"
                                           Visibility="{Binding HasGuide, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </ToggleButton>
                        <TextBox Text="{Binding Evidence, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                 Margin="0,6,0,0" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 Visibility="{Binding Evidence, Converter={StaticResource EmptyToCollapsed}}" />
                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,6,0,0" Focusable="False"
                                      Visibility="{Binding Tags, Converter={StaticResource EmptyToCollapsed}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}" Background="{DynamicResource CardBrush}" Margin="0,0,6,4">
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Cách xử lý -->
                        <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{l:T guide.cause}" Style="{StaticResource H3}" FontSize="13" />
                                <TextBlock Text="{Binding Cause}" Style="{StaticResource Body}" Margin="0,3,0,10" />
                                <TextBlock Text="{l:T guide.steps}" Style="{StaticResource H3}" FontSize="13" />
                                <ItemsControl ItemsSource="{Binding Steps}" Margin="0,6,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="20" Height="20" CornerRadius="10" VerticalAlignment="Top" Background="{DynamicResource AccentSoftBrush}">
                                                    <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Body}" Foreground="{DynamicResource TextBrush}" Margin="8,1,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,8,0,-4">
                            <ToggleButton Style="{StaticResource ExpandHeader}" IsChecked="{Binding IsExpanded}" Margin="0,0,10,4" Padding="2,5"
                                          Visibility="{Binding HasGuide, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE82D;" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" Foreground="{DynamicResource AccentBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{l:T guide.show}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Text" Value="{l:T guide.hide}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ToggleButton>
                            <ItemsControl ItemsSource="{Binding Actions}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource LinkButton}" Margin="0,0,8,4" Content="{Binding Label}"
                                                Command="{Binding DataContext.ActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,36">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:T page.security.title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{l:T page.security.subtitle}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RescanCommand}" VerticalAlignment="Center"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" />
                        <TextBlock Margin="8,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{l:T sec.rescan}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRescanning}" Value="True">
                                            <Setter Property="Text" Value="{l:T sec.rescanning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Grid>

            <views:EmptyState Visibility="{Binding NoResult, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16" />

            <!-- Kết luận -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="16" VerticalAlignment="Top"
                            Background="{Binding Verdict, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                        <TextBlock FontSize="24" Foreground="{Binding Verdict, Converter={StaticResource SeverityBrush}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xEA18;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Verdict}" Value="Critical">
                                            <Setter Property="Text" Value="&#xE7BA;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,16,0">
                        <TextBlock Text="{Binding VerdictTitle}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding VerdictText}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                        <TextBlock Text="{l:T sec.disclaimer}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Border Style="{StaticResource Badge}" Background="{StaticResource DangerSoftBrush}" Margin="0,0,6,0">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}">
                                <Run Text="{Binding CriticalCount, Mode=OneWay}" /> <Run Text="{l:T severity.critical}" />
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="{StaticResource WarningSoftBrush}" Margin="0,0,6,0">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}">
                                <Run Text="{Binding WarningCount, Mode=OneWay}" /> <Run Text="{l:T severity.warning}" />
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="{StaticResource InfoSoftBrush}">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}">
                                <Run Text="{Binding InfoCount, Mode=OneWay}" /> <Run Text="{l:T severity.info}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quét virus bằng Microsoft Defender -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{l:T sec.defender_scan}" Style="{StaticResource H2}" />
                    <TextBlock Text="{l:T sec.defender_scan_desc}" Style="{StaticResource Caption}" Margin="0,3,0,12" TextWrapping="Wrap" TextTrimming="None" />
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding QuickScanCommand}" Margin="0,0,10,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="White" FontSize="14" />
                                <TextBlock Text="{l:T sec.scan_quick}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding FullScanCommand}" Content="{l:T sec.scan_full}" Margin="0,0,10,8" ToolTip="{l:T sec.scan_full_tip}" />
                        <Button Command="{Binding OfflineScanCommand}" Content="{l:T sec.scan_offline}" Margin="0,0,10,8" ToolTip="{l:T sec.scan_offline_tip}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenDefenderCommand}" Content="{l:T sec.open_defender}" Margin="0,0,10,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Bộ lọc -->
            <Grid Margin="0,0,0,10" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowAll}" VerticalAlignment="Center" />
                    <TextBlock Text="{l:T sec.show_all}" Style="{StaticResource Body}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ExpandAllCommand}" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;" FontSize="13" />
                            <TextBlock Text="{l:T common.expand_all}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding CollapseAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73F;" FontSize="13" />
                            <TextBlock Text="{l:T common.collapse_all}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Các nhóm kiểm tra -->
            <ItemsControl ItemsSource="{Binding Sections}" Focusable="False" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource HoverCard}" Padding="16,12" Margin="0,0,0,10">
                            <StackPanel>
                                <ToggleButton Style="{StaticResource ExpandHeader}" IsChecked="{Binding IsExpanded}" AutomationProperties.Name="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="11"
                                                Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="17"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Center"
                                                Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                                            <TextBlock Text="{Binding Summary}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                        </Border>
                                        <Border Grid.Column="3" Width="30" Height="30" CornerRadius="8" Margin="12,0,0,0" Background="{DynamicResource CardAltBrush}">
                                            <TextBlock Style="{StaticResource Chevron}" Tag="{Binding IsExpanded}" />
                                        </Border>
                                    </Grid>
                                </ToggleButton>
                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" Margin="0,4,0,2">
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SecurityItemTemplate}" Focusable="False" />
                                    <TextBlock Text="{l:T sec.section.empty}" Style="{StaticResource Caption}" Margin="54,10,0,0"
                                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
