<UserControl x:Class="PcCheck.App.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcCheck.App.Infrastructure">
    <UserControl.Resources>
        <!-- Hiện một tab theo SelectedTab (Tag của Grid là số thứ tự tab). -->
        <Style x:Key="TabPanel" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <!-- Nút biểu tượng nhỏ trên mỗi dòng -->
        <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{l:T page.storage.title}" Style="{StaticResource H1}" />
            <TextBlock Text="{l:T page.storage.subtitle}" Style="{StaticResource Body}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="StorageTabs" Content="{l:T storage.tab_analyze}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=0}" />
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="StorageTabs" Content="{l:T storage.tab_installers}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=1}" />
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="StorageTabs" Content="{l:T storage.tab_projects}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=2}" />
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="StorageTabs" Content="{l:T storage.tab_history}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=3}" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding BusyText}" Style="{StaticResource Caption}" MaxWidth="360" />
            </StackPanel>
        </Grid>

        <!-- ================= Tab 1: Phân tích ổ đĩa ================= -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid" BasedOn="{StaticResource TabPanel}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Chọn ổ đĩa / thư mục -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding ShowOverview, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Border Style="{StaticResource SubCard}" Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="{l:T storage.overview_hint}" Style="{StaticResource Body}" Margin="0,0,200,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Right" Command="{Binding PickFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" />
                                    <TextBlock Text="{l:T storage.pick_folder}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Locations}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TileButton}" Width="300" Margin="0,0,12,12" Padding="16,14" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding Location.Path}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Margin="0,8,0,0" Height="5" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}"
                                                         Visibility="{Binding IsDrive, Converter={StaticResource BoolToVis}}">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Đang quét -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{l:T storage.analyzing}" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding ScanningPath}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    <ProgressBar Margin="0,14,0,0" IsIndeterminate="True" Height="4" />
                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Command="{Binding CancelCommand}" Content="{l:T storage.cancel}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Kết quả -->
            <Grid Visibility="{Binding ShowReport, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RowIconButton}" Command="{Binding HomeCommand}" ToolTip="{l:T storage.home}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button Style="{StaticResource RowIconButton}" Command="{Binding UpCommand}" ToolTip="{l:T storage.up}" Margin="2,0,0,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentPath}" />
                            <TextBlock Text="{Binding ReportSummary}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding RevealCommand}" CommandParameter="{Binding CurrentPath}" Content="{l:T storage.open_explorer}" Margin="0,0,8,0" />
                            <Button Command="{Binding RescanCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                                    <TextBlock Text="{l:T common.rescan}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="AnalyzerView" Content="{l:T storage.view_folders}"
                                     IsChecked="{Binding AnalyzerView, Converter={StaticResource Equals}, ConverterParameter=0}" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="AnalyzerView"
                                     IsChecked="{Binding AnalyzerView, Converter={StaticResource Equals}, ConverterParameter=1}">
                            <TextBlock>
                                <Run Text="{l:T storage.view_large}" /> (<Run Text="{Binding LargeFiles.Count, Mode=OneWay}" />)
                            </TextBlock>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Thư mục con -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0,4"
                        Visibility="{Binding AnalyzerView, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}">
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Entries}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Files, Mode=OneWay}" /> <Run Text="{Binding Modified, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Insight}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None"
                                                       Foreground="{StaticResource WarningBrush}" Visibility="{Binding Insight, Converter={StaticResource EmptyToCollapsed}}" />
                                        </StackPanel>
                                        <ProgressBar Grid.Column="2" Height="6" Maximum="100" Value="{Binding BarPercent, Mode=OneWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Size}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding Share}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="10,0,0,0">
                                            <Button Style="{StaticResource RowIconButton}" ToolTip="{l:T storage.open_folder}"
                                                    Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>
                                            <Button Style="{StaticResource RowIconButton}" ToolTip="{l:T storage.reveal}"
                                                    Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>
                                            <Button Style="{StaticResource RowIconButton}" ToolTip="{l:T storage.protect}"
                                                    Command="{Binding DataContext.ProtectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>
                                            <Button Style="{StaticResource RowIconButton}" ToolTip="{l:T storage.delete_tip}"
                                                    Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Foreground="{StaticResource DangerBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Tệp lớn nhất -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0,4"
                        Visibility="{Binding AnalyzerView, Converter={StaticResource EmptyToCollapsed}}">
                    <Grid>
                        <TextBlock Text="{l:T storage.no_large}" Style="{StaticResource Body}" Margin="16" HorizontalAlignment="Center"
                                   Visibility="{Binding LargeFiles.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" />
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding LargeFiles}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}">
                                                    <Run Text="{Binding Folder, Mode=OneWay}" /> · <Run Text="{Binding Modified, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Size}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0">
                                                <Button Style="{StaticResource RowIconButton}" ToolTip="{l:T storage.reveal}"
                                                        Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                                <Button Style="{StaticResource RowIconButton}" ToolTip="{l:T storage.delete_tip}"
                                                        Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Foreground="{StaticResource DangerBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= Tab 2: Tệp cài đặt ================= -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid" BasedOn="{StaticResource TabPanel}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="19" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding InstallersSummary}" Style="{StaticResource H3}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding InstallersSelected}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <TextBlock Text="{l:T installer.hint}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding SelectSuggestedInstallersCommand}" Content="{l:T storage.select_suggested}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding SelectNoInstallersCommand}" Content="{l:T common.select_none}" Margin="4,0,12,0" />
                        <Button Command="{Binding ScanInstallersCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                                <TextBlock Text="{l:T common.rescan}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteInstallersCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Foreground="White" />
                                <TextBlock Text="{l:T installer.delete}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0,4"
                    Visibility="{Binding Installers.Count, Converter={StaticResource EmptyToCollapsed}}">
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Installers}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" MaxWidth="460" ToolTip="{Binding Path}" />
                                            <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Padding="8,1" Background="{DynamicResource AccentSoftBrush}">
                                                <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Padding="8,1" Background="{StaticResource SuccessSoftBrush}"
                                                    Visibility="{Binding Installed, Converter={StaticResource EmptyToCollapsed}}">
                                                <TextBlock Text="{Binding Installed}" FontSize="11" Foreground="{StaticResource SuccessBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}">
                                            <Run Text="{Binding Folder, Mode=OneWay}" /> · <Run Text="{Binding Age, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Size}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Style="{StaticResource RowIconButton}" Margin="10,0,0,0" ToolTip="{l:T storage.reveal}"
                                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- ================= Tab 3: Thư mục build dự án ================= -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid" BasedOn="{StaticResource TabPanel}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTab}" Value="2">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE943;" FontSize="19" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ArtifactsSummary}" Style="{StaticResource H3}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ArtifactsSelected}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <TextBlock Text="{l:T purge.hint}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" />
                        <TextBlock Text="{Binding ProjectRootsText}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding SelectOldArtifactsCommand}" Content="{l:T storage.select_suggested}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding SelectNoArtifactsCommand}" Content="{l:T common.select_none}" Margin="4,0,12,0" />
                        <Button Command="{Binding ScanProjectsCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                                <TextBlock Text="{l:T common.rescan}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteArtifactsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Foreground="White" />
                                <TextBlock Text="{l:T purge.delete}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0,4"
                    Visibility="{Binding Artifacts.Count, Converter={StaticResource EmptyToCollapsed}}">
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Artifacts}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Project}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                            <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Padding="8,1" Background="{DynamicResource AccentSoftBrush}">
                                                <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Padding="8,1" Background="{StaticResource WarningSoftBrush}"
                                                    Visibility="{Binding IsRecent, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{l:T purge.recent}" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0">
                                            <Run Text="{Binding KindHint, Mode=OneWay}" /> · <Run Text="{Binding Activity, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Size}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Files}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <Button Grid.Column="3" Style="{StaticResource RowIconButton}" Margin="10,0,0,0" ToolTip="{l:T storage.reveal}"
                                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- ================= Tab 4: Lịch sử dọn dẹp ================= -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid" BasedOn="{StaticResource TabPanel}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTab}" Value="3">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="19" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HistorySummary}" Style="{StaticResource H3}" TextWrapping="Wrap" />
                        <TextBlock Text="{l:T history.hint}" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenHistoryFileCommand}" Content="{l:T history.open_file}" Margin="0,0,8,0" />
                        <Button Command="{Binding RefreshHistoryCommand}" Content="{l:T common.refresh}" Margin="0,0,8,0" />
                        <Button Command="{Binding ClearHistoryCommand}" Content="{l:T history.clear}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0,4"
                    Visibility="{Binding History.Count, Converter={StaticResource EmptyToCollapsed}}">
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding History}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Badge}" Padding="8,1" Background="{DynamicResource AccentSoftBrush}">
                                                <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Action}" Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Target}" Margin="0,3,0,0" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Size}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Count}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
</UserControl>
