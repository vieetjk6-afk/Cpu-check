<Window x:Class="PcCheck.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:PcCheck.App.Infrastructure"
        xmlns:views="clr-namespace:PcCheck.App.Views"
        Title="PC Check Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="{Binding AlwaysOnTop}"
        Opacity="{Binding WindowOpacity}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!-- Margin chừa chỗ cho bóng đổ; kéo thả ở bất kỳ đâu trên thẻ (trừ nút) để di chuyển -->
    <Border x:Name="Root" Margin="12" CornerRadius="16" BorderThickness="1" Padding="14,10,14,12"
            Background="{DynamicResource WidgetBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}"
            MouseLeftButtonDown="OnRootMouseLeftButtonDown">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Cursor" Value="SizeAll" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Locked}" Value="True">
                        <Setter Property="Cursor" Value="Arrow" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" Color="Black" />
        </Border.Effect>
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </Border.LayoutTransform>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{l:T widget.menu.open}" Command="{Binding OpenMainCommand}" />
                <MenuItem Header="{l:T widget.menu.settings}" Command="{Binding OpenSettingsCommand}" />
                <Separator />
                <MenuItem Header="{l:T widget.topmost}" IsCheckable="True" IsChecked="{Binding AlwaysOnTop}" />
                <MenuItem Header="{l:T widget.locked}" IsCheckable="True" IsChecked="{Binding Locked}" />
                <MenuItem Header="{l:T widget.graphs}" IsCheckable="True" IsChecked="{Binding ShowGraphs}" />
                <MenuItem Header="{l:T widget.menu.horizontal}" IsCheckable="True" IsChecked="{Binding IsHorizontal}" />
                <Separator />
                <MenuItem Header="{l:T widget.menu.hide}" Command="{Binding HideCommand}" />
                <MenuItem Header="{l:T widget.menu.exit}" Command="{Binding ExitCommand}" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel>
            <!-- Thanh tiêu đề nhỏ (ẩn ở bố cục ngang cho gọn) -->
            <Grid Margin="0,0,-6,6" Visibility="{Binding IsHorizontal, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="/PcCheck;component/Assets/app.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="PC Check" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="11" Margin="0,0,6,0"
                           Foreground="{DynamicResource TextMutedBrush}" ToolTip="{l:T widget.locked}"
                           Visibility="{Binding Locked, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="3" Style="{StaticResource GhostButton}" Padding="5,3" Cursor="Hand"
                        Command="{Binding OpenSettingsCommand}" ToolTip="{l:T widget.menu.settings}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="11"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Grid.Column="4" Style="{StaticResource GhostButton}" Padding="5,3" Cursor="Hand"
                        Command="{Binding HideCommand}" ToolTip="{l:T widget.menu.hide}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <views:WidgetPanel />
        </StackPanel>
    </Border>
</Window>
