<UserControl x:Class="PcCheck.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcCheck.App.Infrastructure"
             xmlns:c="clr-namespace:PcCheck.App.Controls"
             xmlns:views="clr-namespace:PcCheck.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,36">
            <!-- Tiêu đề -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:T page.dashboard.title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding Main.ExportReportCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="14" />
                        <TextBlock Text="{l:T report.export}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <views:EmptyState Visibility="{Binding NoResult, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16" />

            <!-- Điểm sức khỏe + tóm tắt hệ thống -->
            <Grid Margin="0,0,0,4" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="{l:T dash.health_score}" Style="{StaticResource H2}" />
                        <Grid Width="190" Height="190" Margin="0,14,0,0" HorizontalAlignment="Center">
                            <c:ArcGauge Value="{Binding Score}" Thickness="14"
                                        TrackBrush="{DynamicResource TrackBrush}"
                                        ArcBrush="{Binding ScoreSeverity, Converter={StaticResource SeverityBrush}}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Score}" FontSize="52" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Grade}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{Binding ScoreSeverity, Converter={StaticResource SeverityBrush}}" />
                            </StackPanel>
                        </Grid>
                        <UniformGrid Columns="3" Margin="0,8,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CriticalCount}" Style="{StaticResource H2}" HorizontalAlignment="Center" Foreground="{StaticResource DangerBrush}" />
                                <TextBlock Text="{l:T severity.critical}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding WarningCount}" Style="{StaticResource H2}" HorizontalAlignment="Center" Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="{l:T severity.warning}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding InfoCount}" Style="{StaticResource H2}" HorizontalAlignment="Center" Foreground="{StaticResource InfoBrush}" />
                                <TextBlock Text="{l:T severity.info}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </UniformGrid>
                        <Button Style="{StaticResource LinkButton}" Margin="0,16,0,0" HorizontalAlignment="Center"
                                Command="{Binding Main.NavigateCommand}" CommandParameter="issues" Content="{l:T dash.view_issues}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="{l:T dash.system_info}" Style="{StaticResource H2}" />
                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Command="{Binding Main.NavigateCommand}"
                                    CommandParameter="hardware" Content="{l:T dash.view_details}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SystemItems}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Giám sát trực tiếp -->
            <TextBlock Text="{l:T dash.live}" Style="{StaticResource H2}" Margin="0,6,0,12" />
            <UniformGrid Columns="4" Margin="0,0,-12,0">
                <ContentControl Content="{Binding CpuTile}" ContentTemplate="{StaticResource StatTileTemplate}" Focusable="False" />
                <ContentControl Content="{Binding GpuTile}" ContentTemplate="{StaticResource StatTileTemplate}" Focusable="False" />
                <ContentControl Content="{Binding RamTile}" ContentTemplate="{StaticResource StatTileTemplate}" Focusable="False" />
                <ContentControl Content="{Binding DiskTile}" ContentTemplate="{StaticResource StatTileTemplate}" Focusable="False" />
            </UniformGrid>

            <!-- Các nhóm kiểm tra -->
            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{l:T dash.categories}" Style="{StaticResource H2}" Margin="0,12,0,12" />
                <ItemsControl ItemsSource="{Binding Categories}" Margin="0,0,-12,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,12,12" Padding="16" HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource TileButton}"
                                    Command="{Binding DataContext.Main.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Page}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="11"
                                            Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="17"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" />
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,12,0,12">
                    <TextBlock Text="{l:T dash.top_issues}" Style="{StaticResource H2}" />
                    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Command="{Binding Main.NavigateCommand}"
                            CommandParameter="issues" Content="{l:T dash.view_all}"
                            Visibility="{Binding HasMoreIssues, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding TopIssues}" ItemTemplate="{StaticResource IssueCardTemplate}" Focusable="False" />
                <Border Style="{StaticResource Card}" Visibility="{Binding TopIssues, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource SuccessBrush}" FontSize="18" />
                        <TextBlock Text="{l:T issues.none}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
