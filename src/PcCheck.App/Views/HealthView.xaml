<UserControl x:Class="PcCheck.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcCheck.App.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,36">
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="{l:T page.health.title}" Style="{StaticResource H1}" />
                <TextBlock Text="{l:T page.health.subtitle}" Style="{StaticResource Body}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Thiếu PawnIO -->
            <Border Style="{StaticResource Card}" Background="{StaticResource InfoSoftBrush}" BorderBrush="{StaticResource InfoBrush}" Margin="0,0,0,14"
                    Visibility="{Binding PawnIoMissing, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource InfoBrush}" FontSize="18" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="12,0,12,0">
                        <TextBlock Text="{l:T issue.pawnio.title}" Style="{StaticResource H3}" />
                        <TextBlock Text="{l:T issue.pawnio.detail}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Content="{l:T fix.install_pawnio}"
                            Command="{Binding Main.ExecuteFixCommand}" CommandParameter="{Binding PawnIoFix}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Background="{StaticResource WarningSoftBrush}" Margin="0,0,0,14"
                    Visibility="{Binding SensorsUnavailable, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{l:T health.sensors_unavailable}" Style="{StaticResource Body}" Foreground="{DynamicResource TextBrush}" />
            </Border>

            <!-- Nhiệt độ chính -->
            <UniformGrid Columns="4" Margin="0,0,-12,0">
                <ContentControl Content="{Binding CpuTemp}" ContentTemplate="{StaticResource StatTileTemplate}" Focusable="False" />
                <ContentControl Content="{Binding GpuTemp}" ContentTemplate="{StaticResource StatTileTemplate}" Focusable="False" />
                <ContentControl Content="{Binding DiskTemp}" ContentTemplate="{StaticResource StatTileTemplate}" Focusable="False" />
                <ContentControl Content="{Binding Fans}" ContentTemplate="{StaticResource StatTileTemplate}" Focusable="False" />
            </UniformGrid>

            <!-- Sức khỏe ổ cứng -->
            <Border Style="{StaticResource Card}" Margin="0,2,0,14" Visibility="{Binding Disks, Converter={StaticResource EmptyToCollapsed}}">
                <StackPanel>
                    <TextBlock Text="{l:T health.disks}" Style="{StaticResource H2}" />
                    <TextBlock Text="{l:T health.disks_desc}" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    <ItemsControl ItemsSource="{Binding Disks}" ItemTemplate="{StaticResource InfoGroupTemplate}" Focusable="False" />
                </StackPanel>
            </Border>

            <!-- Pin -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding Battery, Converter={StaticResource EmptyToCollapsed}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{l:T hw.battery}" Style="{StaticResource H2}" />
                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Content="{l:T tool.battery-report.name}"
                                Command="{Binding BatteryReportCommand}" />
                    </Grid>
                    <ContentControl Content="{Binding Battery}" ContentTemplate="{StaticResource InfoGroupTemplate}" Focusable="False" />
                </StackPanel>
            </Border>

            <!-- Tất cả cảm biến -->
            <TextBlock Text="{l:T health.all_sensors}" Style="{StaticResource H2}" Margin="0,4,0,4" />
            <TextBlock Text="{l:T health.all_sensors_desc}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding SensorGroups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" Margin="10,0,0,0" />
                                </StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T sensor.col.name}" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{l:T sensor.col.value}" Style="{StaticResource Caption}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{l:T sensor.col.min}" Style="{StaticResource Caption}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{l:T sensor.col.max}" Style="{StaticResource Caption}" TextAlignment="Right" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextAlignment="Right" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding Min}" TextAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Max}" TextAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource Card}" Visibility="{Binding SensorGroups.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}">
                <TextBlock Text="{l:T health.loading_sensors}" Style="{StaticResource Body}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
