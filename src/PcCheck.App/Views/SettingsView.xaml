<UserControl x:Class="PcCheck.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcCheck.App.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,36" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="{l:T page.settings.title}" Style="{StaticResource H1}" />
                <TextBlock Text="{l:T page.settings.subtitle}" Style="{StaticResource Body}" Margin="0,4,0,0" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{l:T settings.appearance}" Style="{StaticResource H2}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,16">
                        <StackPanel Margin="0,0,320,0">
                            <TextBlock Text="{l:T settings.language}" Style="{StaticResource H3}" />
                            <TextBlock Text="{l:T settings.language_desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Lang" Content="Tiếng Việt"
                                             IsChecked="{Binding Language, Converter={StaticResource Equals}, ConverterParameter=vi}" />
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Lang" Content="English"
                                             IsChecked="{Binding Language, Converter={StaticResource Equals}, ConverterParameter=en}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <StackPanel Margin="0,0,320,0">
                            <TextBlock Text="{l:T settings.theme}" Style="{StaticResource H3}" />
                            <TextBlock Text="{l:T settings.theme_desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Theme" Content="{l:T settings.theme_dark}"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=dark}" />
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Theme" Content="{l:T settings.theme_light}"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=light}" />
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Theme" Content="{l:T settings.theme_system}"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=system}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{l:T settings.behavior}" Style="{StaticResource H2}" Margin="0,0,0,14" />
                    <Grid Margin="0,0,0,16">
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock Text="{l:T settings.autoscan}" Style="{StaticResource H3}" />
                            <TextBlock Text="{l:T settings.autoscan_desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoScan}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid>
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock Text="{l:T settings.live}" Style="{StaticResource H3}" />
                            <TextBlock Text="{l:T settings.live_desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LiveMonitoring}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Cập nhật phần mềm -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Main.Updates}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:T settings.update}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding CurrentText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Top" Background="{StaticResource SuccessSoftBrush}"
                                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding LatestVersion}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                        </Border>
                    </Grid>

                    <!-- Trạng thái -->
                    <Border Style="{StaticResource SubCard}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="16" VerticalAlignment="Top" Margin="0,1,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE895;" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="UpToDate">
                                                <Setter Property="Text" Value="&#xE73E;" />
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Available">
                                                <Setter Property="Text" Value="&#xE896;" />
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                <Setter Property="Text" Value="&#xE783;" />
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Body}" Foreground="{DynamicResource TextBrush}" />
                                <ProgressBar Margin="0,8,0,0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                             Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding ManualHint}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"
                                           Visibility="{Binding ShowManualHint, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Có gì mới -->
                    <StackPanel Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                        <TextBlock Text="{l:T update.whats_new}" Style="{StaticResource H3}" Margin="0,0,0,6" />
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" MaxHeight="220"
                                Background="{DynamicResource WindowBackgroundBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding ReleaseNotes}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <WrapPanel Margin="0,0,0,14">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" Margin="0,0,10,6"
                                Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="White" FontSize="14" />
                                <TextBlock Text="{l:T update.install}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CheckCommand}" Margin="0,0,10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                                <TextBlock Text="{l:T update.check}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenPageCommand}" Content="{l:T update.view}" Margin="0,0,10,6" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding SkipCommand}" Content="{l:T update.skip}" Margin="0,0,10,6"
                                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}" />
                    </WrapPanel>

                    <Grid>
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock Text="{l:T update.auto}" Style="{StaticResource H3}" />
                            <TextBlock Text="{l:T update.auto_desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoCheck}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{l:T settings.report}" Style="{StaticResource H2}" Margin="0,0,0,8" />
                    <TextBlock Text="{l:T settings.report_desc}" Style="{StaticResource Body}" Margin="0,0,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding Main.ExportReportCommand}" Content="{l:T report.export}" Margin="0,0,10,0" />
                        <Button Command="{Binding OpenLogsCommand}" Content="{l:T settings.open_logs}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T settings.about}" Style="{StaticResource H2}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource Body}">
                        <Run Text="PC Check" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /> <Run Text="{Binding Version, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding AdminStatus}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0">
                        <Run Text="{l:T settings.data_folder}" /> <Run Text="{Binding DataFolder, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{l:T settings.shortcuts}" Style="{StaticResource Body}" Margin="0,10,0,0" />
                    <TextBlock Text="{l:T settings.credits}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
