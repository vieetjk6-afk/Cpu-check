<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PcCheck</AssemblyName>
    <RootNamespace>PcCheck.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Title>PC Check</Title>
    <Description>Kiểm tra phần cứng, driver, rác và lỗi máy tính Windows</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcCheck.Core\PcCheck.Core.csproj" />
  </ItemGroup>

  <!-- Loại bản phát hành (portable / small) do CI truyền vào, để trình cập nhật tải đúng tệp. -->
  <ItemGroup Condition="'$(PcCheckFlavor)' != ''">
    <AssemblyMetadata Include="PcCheckFlavor" Value="$(PcCheckFlavor)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
