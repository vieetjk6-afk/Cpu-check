<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bảng màu giao diện tối -->
    <Color x:Key="WindowBackgroundColor">#0E1117</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0E1117" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#141821" />
    <SolidColorBrush x:Key="CardBrush" Color="#181D27" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#202634" />
    <SolidColorBrush x:Key="CardAltBrush" Color="#1E2430" />
    <SolidColorBrush x:Key="LineBrush" Color="#272E3B" />
    <SolidColorBrush x:Key="TextBrush" Color="#E9ECF2" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3AABA" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6E7687" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4F7DFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6A91FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#264F7DFF" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1F2940" />
    <SolidColorBrush x:Key="InputBrush" Color="#121620" />
    <SolidColorBrush x:Key="TrackBrush" Color="#262D3A" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A4252" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#B3000000" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B6FF5" Offset="0" />
        <GradientStop Color="#7C5CFF" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
