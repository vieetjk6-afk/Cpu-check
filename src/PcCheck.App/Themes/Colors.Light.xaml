<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bảng màu giao diện sáng -->
    <Color x:Key="WindowBackgroundColor">#F3F5F9</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F5F9" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#EEF2F8" />
    <SolidColorBrush x:Key="CardAltBrush" Color="#F6F8FB" />
    <SolidColorBrush x:Key="LineBrush" Color="#E2E7EF" />
    <SolidColorBrush x:Key="TextBrush" Color="#161A22" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#545C6C" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8A92A3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3B6FF5" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2F5FE0" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F3B6FF5" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#E8EEFE" />
    <SolidColorBrush x:Key="InputBrush" Color="#F6F8FB" />
    <SolidColorBrush x:Key="TrackBrush" Color="#E6EAF1" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C5CCD8" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#80101828" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B6FF5" Offset="0" />
        <GradientStop Color="#7C5CFF" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
