<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PcCheck.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.13" />
    <PackageReference Include="System.Management" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Lang\*.json" LogicalName="PcCheck.Lang.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcCheck.Core.Tests" />
  </ItemGroup>

</Project>
