<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Cho phép build (không chạy) ứng dụng Windows trên Linux/macOS, ví dụ trong CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.0.0</Version>
    <Authors>vieetjk</Authors>
    <Company>vieetjk</Company>
    <Product>PC Check</Product>
    <Copyright>© 2026 vieetjk</Copyright>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en;vi</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
